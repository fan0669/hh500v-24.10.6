# HH500V (24.10) build config
# usage: cp configs/hh500v-24.10.config .config && make defconfig

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_tcl_linkhub-hh500v=y

# --- base ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_dropbear=y

# --- 5G modem (MHI/PCIe) ---
CONFIG_PACKAGE_kmod-mhi-pci-generic=y
CONFIG_PACKAGE_kmod-mhi-wwan-ctrl=y
CONFIG_PACKAGE_kmod-mhi-wwan-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_comgt=y
# ModemManager dropped on purpose: it opens the MHI MBIM session and never
# produces a usable modem object, which starves netifd's mbim proto.
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-proto-qmi=y

# --- LEDs (AW9523 i2c expander @0x5b drives 5G/4G/WiFi/POWER) ---
# kernel 6.6 has no aw9523 driver; the workflow backports it from v6.11
CONFIG_PINCTRL_AW9523=y
CONFIG_PACKAGE_kmod-leds-gpio=y
# i2c-tools is NOT in the mirror feeds this image uses; pulling it in so that
# i2cget/i2cset exist for debugging the expander (verified useful on 2026-11-04)
CONFIG_PACKAGE_libi2c=y
CONFIG_PACKAGE_i2c-tools=y

# --- buttons + failsafe (hold reset at power-on -> 192.168.1.1, rescue shell) ---
# 24.10 qualcommax has no input subsystem by default, so the DTS "keys" node
# never probes and the reset button is dead. These two pull in input core.
CONFIG_PACKAGE_kmod-input-core=y
CONFIG_PACKAGE_kmod-input-gpio-keys=y


# --- modem GUI ---
CONFIG_PACKAGE_luci-app-modemband=y
CONFIG_PACKAGE_luci-app-3ginfo-lite=y
CONFIG_PACKAGE_luci-app-sms-tool-js=y
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-monitor=y
CONFIG_PACKAGE_luci-app-qmodem-ttlfw4=y
CONFIG_PACKAGE_luci-app-qmodem-uplink=y
CONFIG_PACKAGE_qmodem-seal=y
CONFIG_PACKAGE_qfirehose=y
CONFIG_PACKAGE_libqmodem-sms=y

# --- proxy (official feed) ---
CONFIG_PACKAGE_luci-app-openclash=y
# passwall v1 dropped: it drags in sing-box + v2ray-plugin + shadowsocks-rust
# + shadowsocksr-libev + haproxy + chinadns-ng + dns2socks + microsocks
# + ipt2socks (~75MB uncompressed). passwall2 covers the same use case.
CONFIG_PACKAGE_luci-app-passwall2=y
# passwall2 ships no core of its own - keep xray as the backend.
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_dnsmasq-full=y

# --- proxy (third-party feed, GUI) ---
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-UUGameAcc=y
# nikki + mihomo dropped: mihomo-core alone is 55MB and overlaps openclash.
# homeproxy dropped together with sing-box (homeproxy hard-depends on sing-box).

# --- misc ---
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y

# --- custom: ZeroTier GUI ---
CONFIG_PACKAGE_luci-app-zerotier-q=y
