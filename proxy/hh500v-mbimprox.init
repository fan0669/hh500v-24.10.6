#!/bin/sh /etc/rc.common
# Keeps the MBIM session open so SMS can be read while the data link keeps running.
# Dialing is untouched: netifd still uses proto mbim + umbim on /dev/wwan0mbim0,
# this daemon only proxies that device node through a pty.

START=96
STOP=10
USE_PROCD=1

PROG=/usr/sbin/hh500v-mbimprox
LOG=/tmp/hh500v-mbimprox.log

start_service() {
	# clean any stale bind mount from a previous crash
	umount /dev/wwan0mbim0 2>/dev/null
	[ -x "$PROG" ] || { logger -t mbimprox "binary missing"; return 1; }

	# only makes sense once the MHI MBIM port exists
	[ -c /dev/wwan0mbim0 ] || { logger -t mbimprox "no /dev/wwan0mbim0 yet"; return 1; }

	procd_open_instance
	procd_set_param command "$PROG" -d /dev/wwan0mbim0 -i 60
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

stop_service() {
	umount /dev/wwan0mbim0 2>/dev/null
	rm -f /dev/hh500v-mbim
}
