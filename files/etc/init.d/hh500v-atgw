#!/bin/sh /etc/rc.common

START=98
STOP=05
USE_PROCD=1

PROG=/usr/bin/hh500v-atgw

# Four ports, four clients - see 98-hh500v-qmodem for the map:
#   ttyUSB0  aux clients (sms-tool-js, modemband, 3ginfo)
#   ttyUSB1  qmodem-smsd URC reader (override_at_port)
#   ttyUSB2  QModem at_port
#   ttyUSB3  qmodem-smsd command batch (sms_at_port)
# Every one of them is answered from the same SMS store, so no two clients
# ever read each other's replies.  (Before the split the reader ate the
# gateway's answers and qmodem.sms list failed ~1 call in 3.)
LINKS="/dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyUSB3"

start_service() {
	[ -x "$PROG" ] || return 0
	# only useful once the data session is up: before that the real modem
	# still answers on /dev/ttyUSB2 and the boot-time AT window needs it
	procd_open_instance atgw
	procd_set_param command /bin/sh -c '
		i=0
		while [ $i -lt 300 ]; do
			if ifstatus wwan 2>/dev/null | grep -q "\"up\": true"; then
				break
			fi
			sleep 2
			i=$((i+1))
		done
		set --
		for d in '"$LINKS"'; do
			[ -c "$d" ] && set -- "$@" -d "$d"
		done
		[ $# -gt 0 ] || set -- -d /dev/ttyUSB2
		exec /usr/bin/hh500v-atgw "$@"
	'
	procd_set_param respawn 1800 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ -x "$PROG" ] || return 0
	for d in $LINKS; do
		umount "$d" 2>/dev/null
	done
}
