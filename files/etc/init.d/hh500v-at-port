#!/bin/sh /etc/rc.common
# Discover the modem's AT port after boot (and after any USB re-enumeration)
# so QModem always points at a port that actually answers.

START=40
STOP=90
USE_PROCD=1

start_service() {
	[ -x /usr/bin/hh500v-at-port.sh ] || return 0
	procd_open_instance atport
	procd_set_param command /usr/bin/hh500v-at-port.sh
	# 3 tries max, 10s apart: endless respawning made the script re-probe the
	# AT port every few seconds, which fights with the LED sampler and with
	# QModem for the same tty.
	procd_set_param respawn 3600 10 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
