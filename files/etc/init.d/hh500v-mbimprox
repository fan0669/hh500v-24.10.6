#!/bin/sh /etc/rc.common

# Keeps the single MBIM session of the GM800 alive across umbim's CLOSE and
# forwards arriving SMS to /etc/hh500v-sms.txt without touching the netifd
# proto mbim dial path.
#
# Must start before /etc/init.d/hh500v-wwan-up (S97) dials, and it waits for
# the MHI port which only shows up ~160s after a cold boot.

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/hh500v-mbimprox
DEV=/dev/wwan0mbim0
INTERVAL=300

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		dev="'"$DEV"'"
		for i in $(seq 1 300); do
			[ -c "$dev" ] && break
			sleep 1
		done
		[ -c "$dev" ] || { logger -t hh500v-mbimprox "no $dev, giving up"; exit 1; }
		umount "$dev" 2>/dev/null
		exec '"$PROG"' -d "$dev" -i '"$INTERVAL"'
	'
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall hh500v-mbimprox 2>/dev/null
	sleep 1
	umount "$DEV" 2>/dev/null
}
